{
  "name": "@don-juan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "predev": "pnpm --filter @don-juan/contracts build && pnpm --filter @don-juan/database build",
    "dev": "tsx watch src/main.ts",
    "test:integration": "vitest run src/auth.integration.test.ts"
  },
  "dependencies": {
    "@don-juan/contracts": "workspace:*",
    "@don-juan/database": "workspace:*",
    "fastify": "^5.12.0",
    "@don-juan/domain": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0"
  }
}
