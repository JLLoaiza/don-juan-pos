{
  "name": "@don-juan/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @don-juan/contracts build && pnpm --filter @don-juan/ui build",
    "dev": "vite",
