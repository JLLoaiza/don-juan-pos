DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
API_HOST=0.0.0.0
API_PORT=3000
WORKER_ID=local-worker


# Docker Compose host ports. PostgreSQL defaults to 5433 to coexist with bd/.
POSTGRES_PORT=5433
HOST_API_PORT=3000
CORS_ORIGINS=http://localhost:5173
HOST_WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
# Optional: pre-fills/hides the company field on the login screen. Set to the
# company the deployed device belongs to (e.g. Compose's dev seed company).
VITE_DEFAULT_COMPANY_ID=00000000-0000-7000-8000-000000000001
